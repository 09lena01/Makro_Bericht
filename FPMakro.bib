	file = {Full Text PDF:C\:\\Users\\Lenarus\\Zotero\\storage\\NZNAPUJY\\Jordan et al. - 2021 - A solvent-reagent selection guide for Steglich-type esterification of carboxylic acids.pdf:application/pdf;Snapshot:C\:\\Users\\Lenarus\\Zotero\\storage\\TIKYB9UG\\d1gc02251b.html:text/html},
}

