}

@article{mannu_fischer-speier_2024,
	title = {Fischer-Speier Esterification and Beyond: Recent Mechanicistic Advances},
	volume = {14},
	rights = {https://creativecommons.org/licenses/by/3.0/},
	issn = {2073-4344},
	url = {https://www.mdpi.com/2073-4344/14/12/931},
	doi = {10.3390/catal14120931},
	shorttitle = {Fischer-Speier Esterification and Beyond},
	abstract = {Over the past 130 years, Fischer-Speier esterification has been established as the benchmark method for synthesizing esters from organic acids and alcohols. The reaction’s versatility, arising from the vast combinations of starting materials and the numerous catalytic alternatives to the traditional H2SO4, has maintained its relevance, with a steady flow of publications addressing new developments. This review highlights the most significant contributions to Fischer-Speier esterification over the past five years, with a particular emphasis on mechanistic advancements and innovative catalytic systems. Both homogeneous and heterogeneous catalytic approaches are discussed, including novel catalysts leveraging hydrogen-bonding interactions and systems offering fresh insights into specific reaction mechanisms and atypical methodologies. Some of these catalytic systems, as ionic liquids or sulfonated heterogeneous catalytic precursors, reached excellent yields ({\textgreater}90\%), e.g., in the synthesis of fatty acids methyl esters. Also, classic catalysts such as H2SO4 and para-toluen sulfonic acid were optimized for quantitative conversions (e.g., in the esterification of trans-cinnamic acid with methanol). A consistent number of catalysts was studied with model substrates (as benzoic acid in combination with methanol, ethanol, and ethylene glycol), and new activation pathways were presented.},
	pages = {931},
	number = {12},
	journaltitle = {Catalysts},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Mannu, Alberto and Mele, Andrea},
	urldate = {2026-11-02},
	date = {2024-12},
	langid = {english},
	keywords = {esterification mechanism, Fischer-Speier esterification, ionic liquids, solid acid catalysis},
	file = {Full Text PDF:C\:\\Users\\Lenarus\\Zotero\\storage\\7SFM3GVB\\Mannu und Mele - 2024 - Fischer-Speier Esterification and Beyond Recent Mechanicistic Advances.pdf:application/pdf},
}

