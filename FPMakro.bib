	file = {Full Text PDF:C\:\\Users\\Lenarus\\Zotero\\storage\\5WWYL7UI\\Ali et al. - 2007 - Synthesis of poly(2-hydroxypropyl methacrylate) latex particles via aqueous dispersion polymerizatio.pdf:application/pdf;Snapshot:C\:\\Users\\Lenarus\\Zotero\\storage\\5HZ2Y9SH\\b704425a.html:text/html},
