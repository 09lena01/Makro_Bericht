	url = {https://www.sciencedirect.com/science/article/pii/S002228602101629X},
	doi = {10.1016/j.molstruc.2021.131501},
	abstract = {{FT}-{IR} and Raman spectra of α-Lipoic acid ({LA}), a molecule present in almost all eukaryotic cells that exhibits intracellular metabolic properties, were recorded and analyzed by means of both experimental and {DFT} based theoretical methods. Moreover, the adsorption behavior of {LA} on silver (Ag) nanoparticles surface at different concentrations was thoroughly investigated by {SERS} and the lowest detectable concentration of {LA} was found to be of 10−9 M. The analyte concentration dependence on {SERS} evidenced that at concentrations between 10−2 M and 10−7 M the {LA} molecule is chemisorbed on the Ag nanoparticles surface through the carboxyl group and is predominantly perpendicular with respect to the metal surface, whereas at lower concentrations (up to 10−9 M) a reorientation of the adsorbed species takes place.},
	pages = {131501},
	journaltitle = {Journal of Molecular Structure},
	shortjournal = {Journal of Molecular Structure},
