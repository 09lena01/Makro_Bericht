@article{liu_architecture-controlled_2019,
	title = {Architecture-Controlled Ring-Opening Polymerization for Dynamic Covalent Poly(disulfide)s},
	volume = {141},
	issn = {0002-7863},
	url = {https://doi.org/10.1021/jacs.9b08957},
	doi = {10.1021/jacs.9b08957},
	abstract = {A strategy is reported for controlling
the architecture of poly­(disulfide)­s
by ring-opening polymerization. Aryl thiol initiators shift the ring–chain equilibrium to yield cyclic polymers, while alkyl thiols favor linear ones. Control over polymerization enables synthesis of large polymers (630 {kDa}) and catalytic depolymerization to recycle monomers. This work provides a new avenue to create dynamic covalent polymers with controlled geometry and length, allowing better characterization of structure–property relationships to expand their materials
potentials.},
	pages = {17075--17080},
	number = {43},
	journaltitle = {Journal of the American Chemical Society},
	shortjournal = {Journal American Chemical Society},
	author = {Liu, Yun and Jia, Yuan and Wu, Qiong and Moore, Jeffrey S.},
	urldate = {2026-08-10},
