	volume = {1248},
	issn = {0022-2860},
	url = {https://www.sciencedirect.com/science/article/pii/S002228602101629X},
	doi = {10.1016/j.molstruc.2021.131501},
	abstract = {{FT}-{IR} and Raman spectra of α-Lipoic acid ({LA}), a molecule present in almost all eukaryotic cells that exhibits intracellular metabolic properties, were recorded and analyzed by means of both experimental and {DFT} based theoretical methods. Moreover, the adsorption behavior of {LA} on silver (Ag) nanoparticles surface at different concentrations was thoroughly investigated by {SERS} and the lowest detectable concentration of {LA} was found to be of 10−9 M. The analyte concentration dependence on {SERS} evidenced that at concentrations between 10−2 M and 10−7 M the {LA} molecule is chemisorbed on the Ag nanoparticles surface through the carboxyl group and is predominantly perpendicular with respect to the metal surface, whereas at lower concentrations (up to 10−9 M) a reorientation of the adsorbed species takes place.},
	pages = {131501},
	journaltitle = {Journal of Molecular Structure},
	shortjournal = {Journal of Molecular Structure},
	author = {Rusu, E. A. and Magyari, K. and Baia, L. and Baia, M.},
	urldate = {2026-11-02},
	date = {2022-01-15},
	keywords = {Concentration dependence, {DFT} calculations, {FT}-{IR} and Raman spectroscopy, {SERS}, α-lipoic acid},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\Lenarus\\Zotero\\storage\\CTQ3V6PG\\Rusu et al. - 2022 - Vibrational analysis of α-lipoic acid and its adsorption behavior study by SERS.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\Lenarus\\Zotero\\storage\\GLYLAPU8\\S002228602101629X.html:text/html},
}

@article{koelbl_greener_2025,
	title = {A Greener and More Scalable Synthesis of Biogenic Polydisulfides from Lipoic Acid},
	volume = {18},
	issn = {1864-564X},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/cssc.202500194},
	doi = {10.1002/cssc.202500194},
	abstract = {Ring-opening polymerization ({ROP}) of 1,2-dithiolanes form polydisulfides, an emergent class of dynamic covalent polymers. However, both monomer and polymer syntheses typically require anaerobic and moisture-free conditions, often employing hazardous reagents and solvents that limit scalability. Herein, efficient, scalable syntheses for poly(ethyl lipoate) and ethyl lipoate that incorporate Green Chemistry principles are disclosed. The synthesis of ethyl lipoate from lipoic acid on a 100-gram scale ({\textgreater}80\% yield) is optimized lowering the E-factor (2.27) by an order of magnitude compared to conventional methods. Diphenyl phosphate, a nonhazardous commercial organic acid, is used to synthesize ultra-high-molecular-weight poly(ethyl lipoate) on a 50-gram scale from cationic {ROP} ({CROP}). The polymerizations proceed under ambient atmosphere in low-hazard and renewable solvents, and a mild depolymerization strategy to regenerate the monomer is developed. Due to their extreme molar mass, the materials possess unique mechanical and physical properties. Life cycle assessment ({LCA}) conducted on synthetic and recycling processes shows that the polydisulfide has competitive environmental impacts comparable to several commodity polymers, despite the latter having an efficiency advantage due to economies of scale. These discoveries establish an economical and scalable closed-loop polymer platform that can be broadly applied to various polydisulfides sourced from 1,2-dithiolanes such as lipoic acid.},
	pages = {e202500194},
	number = {13},
	journaltitle = {{ChemSusChem}},
	author = {Koelbl, Christopher B. and Obunadike, Chizoba and Ham, Woojung and Mahmud, Nadim and Garcia, Mathew and Lizundia, Erlantz and Worch, Joshua C.},
	urldate = {2026-11-02},
	date = {2025},
	langid = {english},
	keywords = {circular polymers, green chemistry, life cycle assessment},
	file = {Full Text PDF:C\:\\Users\\Lenarus\\Zotero\\storage\\E5MJ9F7S\\Koelbl et al. - 2025 - A Greener and More Scalable Synthesis of Biogenic Polydisulfides from Lipoic Acid.pdf:application/pdf;Snapshot:C\:\\Users\\Lenarus\\Zotero\\storage\\SJPY63JL\\cssc.html:text/html},
}

@article{tang_lipoates_2015,
	title = {Lipoates as building blocks of sulfur-containing branched macromolecules},
	volume = {6},
	issn = {1759-9954},
	url = {https://doi.org/10.1039/c5py01005e},
	doi = {10.1039/c5py01005e},
	abstract = {The radical copolymerization of cyclic disulfide-type monomers (ethyl lipoate or lipoic acid) with ethyl acrylate (1 : 1 molar feed ratio) yielded copolymers containing a significant fraction of backbone disulfide groups, which were degradable upon reduction. A compound containing two types of radically polymerizable groups (cyclic disulfide (1,2-dithiolane) and vinyl), 2-acryloyloxyethyl lipoate ({AOELp}), was synthesized and demonstrated to be a useful precursor for highly branched sulfur-containing polymers. Under radical polymerization conditions, {AOELp} served as a crosslinker, but up to moderate to high conversions and prior to gelation, soluble highly branched polymers were produced containing reductively degradable disulfide moieties, originating from the attack of a sulfur-centered radical on a 1,2-dithiolane group from {AOELp} or the polymer (pendant group), or the coupling of two sulfur-centered radicals. Alternatively, the reduction of {AOELp} afforded the corresponding dithiol acrylate (an {AB}2-type monomer), which participated in radical or ionic step-growth thiol–ene reactions, yielding highly branched reductively non-degradable polymers with thioether-type sulfur atoms in the backbones.},
	pages = {6936--6945},
	number = {39},
	journaltitle = {Polymer Chemistry},
	shortjournal = {Polym. Chem.},
	author = {Tang, Houliang and Tsarevsky, Nicolay V.},
	urldate = {2026-11-02},
	date = {2015-10-21},
	file = {Full Text PDF:C\:\\Users\\Lenarus\\Zotero\\storage\\TDQVC45N\\Tang und Tsarevsky - 2015 - Lipoates as building blocks of sulfur-containing branched macromolecules.pdf:application/pdf;Snapshot:C\:\\Users\\Lenarus\\Zotero\\storage\\TXJZLLJG\\c5py01005e.html:text/html},
}

@article{albanese_controlled-radical_2023,
